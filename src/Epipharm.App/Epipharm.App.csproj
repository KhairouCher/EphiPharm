<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>Epipharm.App</RootNamespace>
    <AssemblyName>Epipharm</AssemblyName>
    <ApplicationIcon />
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Epipharm.Data\Epipharm.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The real DOS VGA bitmap font (see Resources/Fonts/NOTICE.md) — copied
         next to the exe so RetroTheme can load it at runtime without it
         being installed system-wide (PrivateFontCollection, see
         RetroTheme.cs). -->
    <Content Include="Resources\Fonts\Px437_IBM_VGA_8x16.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\Fonts\NOTICE.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
